  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthStatus": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "HealthStatus"
      },
      "HumidityValue": {
        "properties": {
          "humidity": {
            "type": "number",
            "title": "Humidity"
          }
        },
        "type": "object",
        "required": [
          "humidity"
        ],
        "title": "HumidityValue"
      },
      "OccupancyState": {
        "type": "string",
        "enum": [
          "occupied",
          "unoccupied",
          "standby"
        ],
        "title": "OccupancyState"
      },
      "OccupancyValue": {
        "properties": {
          "occupancy": {
            "$ref": "#/components/schemas/OccupancyState"
          }
        },
        "type": "object",
        "required": [
          "occupancy"
        ],
        "title": "OccupancyValue"
      },
      "SetpointValue": {
        "properties": {
          "setpoint": {
            "type": "number",
            "maximum": 120.0,
            "minimum": 40.0,
            "title": "Setpoint"
          }
        },
        "type": "object",
        "required": [
          "setpoint"
        ],
        "title": "SetpointValue"
      },
      "TemperatureValue": {
        "properties": {
          "temperature": {
            "type": "number",
            "title": "Temperature"
          }
        },
        "type": "object",
        "required": [
          "temperature"
        ],
        "title": "TemperatureValue"
      },
      "ThermostatList": {
        "properties": {
          "thermostats": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Thermostats"
          }
        },
        "type": "object",
        "required": [
          "thermostats"
        ],
        "title": "ThermostatList"
      },
      "Transition": {
        "properties": {
          "time": {
            "type": "string",
            "format": "time",
            "title": "Time"
          },
          "state": {
            "$ref": "#/components/schemas/OccupancyState"
          }
        },
        "type": "object",
        "required": [
          "time",
          "state"
        ],
        "title": "Transition",
        "description": "A change point: the state holds until the day's next transition."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "WeeklySchedule": {
        "properties": {
          "Mon": {
            "items": {
              "$ref": "#/components/schemas/Transition"
            },
            "type": "array",
            "title": "Mon"
          },
          "Tue": {
            "items": {
              "$ref": "#/components/schemas/Transition"
            },
            "type": "array",
            "title": "Tue"
          },
          "Wed": {
            "items": {
              "$ref": "#/components/schemas/Transition"
            },
            "type": "array",
            "title": "Wed"
          },
          "Thu": {
            "items": {
              "$ref": "#/components/schemas/Transition"
            },
            "type": "array",
            "title": "Thu"
          },
          "Fri": {
            "items": {
              "$ref": "#/components/schemas/Transition"
            },
            "type": "array",
            "title": "Fri"
          },
          "Sat": {
            "items": {
              "$ref": "#/components/schemas/Transition"
            },
            "type": "array",
            "title": "Sat"
          },
          "Sun": {
            "items": {
              "$ref": "#/components/schemas/Transition"
            },
            "type": "array",
            "title": "Sun"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "Mon",
          "Tue",
          "Wed",
          "Thu",
          "Fri",
          "Sat",
          "Sun"
        ],
        "title": "WeeklySchedule",
        "description": "One list of transitions per day. All seven are required; use [] for none.\n\nFields are Monday first, matching the order of the BACnet weekly-schedule array."
      }
    }
  }
}